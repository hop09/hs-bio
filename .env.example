# MongoDB Atlas
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@CLUSTER.mongodb.net/hsbio?retryWrites=true&w=majority
MONGODB_DB=hsbio

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistent Hostinger storage
# Use an absolute writable path in production when possible.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=200
